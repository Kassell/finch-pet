{
  "name": "finch-pet",
  "version": "1.0.9",
  "type": "module",
  "description": "Desktop pet for Finch.",
  "author": {
    "name": "Kassell",
    "url": "https://github.com/Kassell"
  },
  "homepage": "https://github.com/Kassell/finch-pet",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kassell/finch-pet.git"
  },
  "license": "MIT",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:zip && npm run build:game-core && npm run build:canvas && npm run build:webview",
    "build:zip": "esbuild src/host/infrastructure/archive/zip.ts --bundle --platform=node --format=esm --target=node20 --charset=utf8 --outfile=dist/host/infrastructure/archive/zip.js",
    "build:game-core": "esbuild src/game/core/game.ts src/game/core/app-registry.ts src/game/pet/systems/pet-animation-system.ts src/game/pet/systems/pet-bubble-system.ts --bundle --platform=node --format=esm --target=node20 --charset=utf8 --outbase=src --outdir=dist",
    "build:canvas": "tsc -p tsconfig.canvas.json && esbuild src/game/main.ts --bundle --format=iife --charset=utf8 --outfile=pet-canvas.js --banner:js=\"/* 本文件由 src/game 源码构建生成,请勿直接编辑;运行 npm run build:canvas 重新生成。 */\"",
    "build:webview": "esbuild src/webview/pet-catalog.ts --bundle --format=esm --target=es2022 --charset=utf8 --outfile=dist/pet-catalog.js && esbuild src/webview/pet-catalog.html src/webview/pet-catalog.css --outdir=dist --loader:.html=copy --loader:.css=copy",
    "test": "npm run build && node --test test/*.test.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "check": "npm test",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@finchtoys/minitool-api": "0.3.1",
    "@types/node": "^26.1.0",
    "esbuild": "^0.28.1",
    "fflate": "^0.8.3",
    "typescript": "^6.0.3"
  },
  "files": [
    "dist/",
    "finch.json",
    "pets/",
    "public/",
    "pet-canvas.js",
    "icon.png",
    "icons/",
    "i18n/",
    "README.md",
    "README.en-US.md",
    "README.zh-CN.md",
    "ARCHITECTURE.md",
    "FINCH-CANVAS-API-REQUESTS.md",
    "CANVAS-WINDOW-SERVICE-HANDOFF.md",
    "package.json"
  ]
}
